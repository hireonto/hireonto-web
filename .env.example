# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables (Production).

# Email: "resend" (recommended) or "smtp"
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="HireOnto <no-reply@hireonto.com>"   # must be on a domain verified in Resend
SALES_EMAIL=             # where verified demo requests are delivered

# Only if EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587            # 587 = STARTTLS, 465 = SSL
SMTP_SECURE=             # optional; auto: true on 465, false otherwise
SMTP_USER=
SMTP_PASS=

# OTP hashing secret (any long random string: `openssl rand -hex 32`)
DEMO_OTP_SECRET=

# Upstash Redis (shared OTP + rate-limit store on Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
